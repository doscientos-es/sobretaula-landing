---
import LucideIcon from './LucideIcon.astro';
const { label='Vista de producto' } = Astro.props;
---
<figure class="overflow-hidden rounded-xl border border-[#e8e8e9] bg-white shadow-[0_5px_16px_rgb(35_39_45_/_4%)]" aria-label={label}><figcaption class="flex items-center gap-3 border-b border-[#e8e8e9] px-4 py-3 text-sm font-medium text-[#737983]"><LucideIcon name="layout" /><span>{label}</span></figcaption><div class="grid min-h-[290px] grid-cols-[82px_1fr] sm:min-h-[360px] sm:grid-cols-[130px_1fr]"><aside class="border-r border-[#e8e8e9] bg-[#f8f8f8] p-3"><div class="h-5 w-14 rounded-md bg-[#ff5f4d]"></div><div class="mt-9 space-y-3"><div class="h-2 w-11 rounded bg-[#dadbdd]"></div><div class="h-2 w-14 rounded bg-[#dadbdd]"></div><div class="h-2 w-10 rounded bg-[#dadbdd]"></div></div></aside><div class="p-5 sm:p-8"><div class="flex justify-between"><div><div class="h-3 w-24 rounded bg-[#b8c1d1]"></div><div class="mt-3 h-7 w-48 rounded bg-[#292d34]"></div></div><div class="h-9 w-20 rounded-lg bg-[#fff0ee]"></div></div><div class="mt-8 grid gap-3 sm:grid-cols-3"><div class="h-24 rounded-lg bg-[#f2f2f3]"></div><div class="h-24 rounded-lg bg-[#eeeeef]"></div><div class="h-24 rounded-lg bg-[#f5f5f6]"></div></div><div class="mt-4 h-28 rounded-lg border border-[#e8e8e9] bg-white"></div></div></div></figure>
