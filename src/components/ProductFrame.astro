---
const { label='Vista de producto', accent='lime' } = Astro.props;
---
<div class="relative overflow-hidden rounded-2xl border border-[#cbd5cc] bg-[#fbfcf8] shadow-[0_22px_70px_-28px_rgba(24,61,49,.45)]" aria-label={`${label}. Placeholder de captura de producto.`}><div class="flex items-center gap-2 border-b border-[#e1e8e0] px-4 py-3"><i class="h-2 w-2 rounded-full bg-[#f19b7d]"></i><i class="h-2 w-2 rounded-full bg-[#e5c66d]"></i><i class="h-2 w-2 rounded-full bg-[#9dc785]"></i><span class="ml-3 text-[10px] font-semibold uppercase tracking-[.18em] text-[#8b9990]">{label}</span></div><div class="grid min-h-[290px] grid-cols-[82px_1fr] sm:min-h-[360px] sm:grid-cols-[130px_1fr]"><aside class="border-r border-[#e1e8e0] bg-[#f3f6ef] p-3"><div class="h-5 w-14 rounded bg-[#183d31]"></div><div class="mt-9 space-y-3"><div class="h-2 w-11 rounded bg-[#cbd7cb]"></div><div class="h-2 w-14 rounded bg-[#cbd7cb]"></div><div class="h-2 w-10 rounded bg-[#cbd7cb]"></div><div class="h-2 w-12 rounded bg-[#cbd7cb]"></div></div></aside><div class="p-5 sm:p-8"><div class="flex justify-between"><div><div class="h-3 w-24 rounded bg-[#b7c6b8]"></div><div class="mt-3 h-7 w-48 rounded bg-[#183d31]/90"></div></div><div class="h-9 w-20 rounded-full bg-[#d7f36b]"></div></div><div class="mt-8 grid gap-3 sm:grid-cols-3"><div class="h-24 rounded-xl bg-[#e7eee3]"></div><div class="h-24 rounded-xl bg-[#dce8d8]"></div><div class="h-24 rounded-xl bg-[#eaf0e5]"></div></div><div class="mt-4 h-28 rounded-xl border border-[#dce5db] bg-white"><div class="m-4 h-2 w-2/3 rounded bg-[#dce5db]"></div><div class="m-4 h-2 w-1/2 rounded bg-[#edf1eb]"></div></div><div class="mt-5 flex items-center gap-2 text-[10px] font-medium text-[#829087]"><span class="rounded bg-[#eef5c9] px-2 py-1 text-[#55711d]">CAPTURA PENDIENTE</span><span>Datos de demo coherentes</span></div></div></div></div>
