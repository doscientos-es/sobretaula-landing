---
const { name = 'calendar', label } = Astro.props;
const paths = { calendar: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z', layout: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z', chart: 'M4 19V5M4 19h16M8 16v-5M12 16V7M16 16v-9' };
---
<svg aria-hidden={label ? undefined : 'true'} aria-label={label} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d={paths[name as keyof typeof paths]} /></svg>
