---
import '../styles/global.css';
const { lang='es', title='Sobretaula — claridad para gestionar tu restaurante', description='Reservas, sala, carta y finanzas en un mismo lugar.' } = Astro.props;
const ca = lang === 'ca';
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={`https://sobretaula.es/${lang}`} /><link rel="alternate" hreflang="es" href="https://sobretaula.es/es" /><link rel="alternate" hreflang="ca" href="https://sobretaula.es/ca" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /></head><body><header class="sticky top-0 z-20 border-b border-[#dfe5df]/80 bg-[#f7f5ef]/90 backdrop-blur"><div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8"><a href={`/${lang}`} class="focus-ring text-xl font-semibold tracking-[-.05em]">sobre<span class="text-[#87a900]">taula</span></a><nav class="hidden items-center gap-7 text-sm text-[#65736d] md:flex"><a class="focus-ring hover:text-[#17211d]" href={`/${lang}#producto`}>{ca?'Producte':'Producto'}</a><a class="focus-ring hover:text-[#17211d]" href={`/${lang}#modulos`}>{ca?'Mòduls':'Módulos'}</a><a class="focus-ring hover:text-[#17211d]" href={`/${lang}#quien`}>{ca?'Per a restaurants':'Para restaurantes'}</a></nav><div class="flex items-center gap-3"><a class="focus-ring text-xs font-semibold" href={ca?'/es':'/ca'}>{ca?'ES':'CA'}</a><a href={`/${lang}#contacto`} class="focus-ring hidden rounded-full bg-[#183d31] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#285b47] sm:inline-block">{ca?'Sol·licitar demo':'Solicitar demo'}</a><button class="focus-ring rounded-lg border border-[#dfe5df] p-2 md:hidden" aria-label="Abrir menú">☰</button></div></div></header><main><slot /></main><footer class="border-t border-[#dfe5df] bg-[#183d31] px-5 py-12 text-[#e8f0de] lg:px-8"><div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-3"><div><div class="text-xl font-semibold tracking-[-.05em]">sobre<span class="text-[#d7f36b]">taula</span></div><p class="mt-4 max-w-xs text-sm leading-6 text-[#b8c9bd]">{ca?'Més claredat per a cada servei.':'Más claridad para cada servicio.'}</p></div><div class="grid grid-cols-2 gap-3 text-sm text-[#b8c9bd]"><a href={`/${lang}#producto`} class="hover:text-white">{ca?'Producte':'Producto'}</a><a href={`/${lang}#modulos`} class="hover:text-white">{ca?'Mòduls':'Módulos'}</a><a href={`/${lang}#quien`} class="hover:text-white">{ca?'Per a restaurants':'Para restaurantes'}</a><a href={`/${lang}#contacto`} class="hover:text-white">Contacto</a></div><div class="text-sm text-[#b8c9bd]"><p>© {new Date().getFullYear()} Sobretaula</p><p class="mt-2">Privacidad · Cookies</p></div></div></footer></body></html>
