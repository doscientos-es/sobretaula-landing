---
import '../styles/global.css';
const { lang='es', title='Sobretaula — claridad para gestionar tu restaurante', description='Reservas, sala, carta y finanzas en un mismo lugar.' } = Astro.props;
const ca = lang === 'ca';
const links = ca ? { product:'Producte', modules:'Mòduls', audience:'Per a restaurants', prices:'Preus', contact:'Contacte', about:'Sobre Sobretaula', resources:'Recursos', help:'Centre d’ajuda' } : { product:'Producto', modules:'Módulos', audience:'Para restaurantes', prices:'Precios', contact:'Contacto', about:'Sobre Sobretaula', resources:'Recursos', help:'Centro de ayuda' };
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" href="/icon.svg" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={`https://sobretaula.es/${lang}`} /><link rel="alternate" hreflang="es" href="https://sobretaula.es/es" /><link rel="alternate" hreflang="ca" href="https://sobretaula.es/ca" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /></head><body><header class="sticky top-0 z-20 border-b border-[#dfe5df]/80 bg-[#f7f5ef]/90 backdrop-blur"><div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8"><a href="/" class="focus-ring text-xl font-semibold tracking-[-.05em]">sobre<span class="text-[#87a900]">taula</span></a><nav class="hidden items-center gap-7 text-sm text-[#65736d] md:flex"><a class="focus-ring hover:text-[#17211d]" href={ca?'/ca/producte':'/es/producto'}>{links.product}</a><a class="focus-ring hover:text-[#17211d]" href={ca?'/ca#moduls':'/es#modulos'}>{links.modules}</a><a class="focus-ring hover:text-[#17211d]" href={ca?'/ca#qui':'/es#quien'}>{links.audience}</a><a class="focus-ring hover:text-[#17211d]" href={ca?'/ca/preus':'/es/precios'}>{links.prices}</a></nav><div class="flex items-center gap-3"><a class="focus-ring text-xs font-semibold" href={ca?'/es':'/ca'}>{ca?'ES':'CA'}</a><a href={ca?'/ca#contacte':'/es/contacto'} class="focus-ring hidden rounded-lg bg-[#183d31] px-4 py-2.5 text-sm font-semibold text-white shadow-sm sm:inline-block">{ca?'Sol·licitar demo':'Solicitar demo'}</a><button class="focus-ring rounded-lg border border-[#dfe5df] p-2 md:hidden" aria-label={ca?'Obrir menú':'Abrir menú'}>☰</button></div></div></header><main><slot /></main><footer class="border-t border-[#e8e8e9] bg-white px-5 py-16 text-[#292d34] lg:px-8"><div class="mx-auto max-w-7xl"><div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.2fr_repeat(4,1fr)]"><div><a href="/" class="text-xl font-semibold tracking-[-.05em]">sobre<span class="text-[#ff5f4d]">taula</span></a><p class="mt-5 max-w-xs text-sm leading-6 text-[#737983]">{ca?'Programari de gestió per a restaurants que volen treballar amb claredat.':'Software de gestión para restaurantes que quieren trabajar con claridad.'}</p><a href={ca?'/ca/contacte':'/es/contacto'} class="mt-6 inline-block text-sm font-semibold text-[#ff5f4d] hover:underline">{links.contact} →</a></div><div><h2 class="text-sm font-semibold">{links.product}</h2><ul class="mt-4 space-y-3 text-sm text-[#737983]"><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca#moduls':'/es/modulos/reservas'}>{ca?'Reserves':'Reservas'}</a></li><li><a class="hover:text-[#ff5f4d]" href="/es/modulos/tpv">TPV i cobraments</a></li><li><a class="hover:text-[#ff5f4d]" href="/es/modulos/carta">{ca?'Carta digital':'Carta digital'}</a></li><li><a class="hover:text-[#ff5f4d]" href="/es/modulos/operaciones">{ca?'Operacions':'Operaciones'}</a></li><li><a class="hover:text-[#ff5f4d]" href="/es/modulos/finanzas">{ca?'Finances':'Finanzas'}</a></li></ul></div><div><h2 class="text-sm font-semibold">Soluciones</h2><ul class="mt-4 space-y-3 text-sm text-[#737983]"><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca#qui':'/es/para-restaurantes'}>{ca?'Restaurants independents':'Restaurantes independientes'}</a></li><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca#qui':'/es/para-restaurantes'}>{ca?'Cafeteries':'Cafeterías'}</a></li><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca#qui':'/es/para-restaurantes'}>{ca?'Petits grups':'Pequeños grupos'}</a></li></ul></div><div><h2 class="text-sm font-semibold">{ca?'Aprèn':'Aprende'}</h2><ul class="mt-4 space-y-3 text-sm text-[#737983]"><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca/producte':'/es/producto'}>{links.product}</a></li><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca/preus':'/es/precios'}>{links.prices}</a></li><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca/contacte':'/es/contacto'}>{links.resources}</a></li></ul></div><div><h2 class="text-sm font-semibold">{ca?'Empresa i suport':'Empresa y soporte'}</h2><ul class="mt-4 space-y-3 text-sm text-[#737983]"><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca#producte':'/es/producto'}>{links.about}</a></li><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca/contacte':'/es/contacto'}>{links.help}</a></li><li><a class="hover:text-[#ff5f4d]" href={ca?'/ca/contacte':'/es/contacto'}>{links.contact}</a></li></ul></div></div><div class="mt-14 flex flex-col gap-4 border-t border-[#e8e8e9] pt-6 text-xs text-[#737983] sm:flex-row sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} Sobretaula</p><div class="flex gap-4"><a href="#" class="hover:text-[#ff5f4d]">Aviso legal</a><a href="#" class="hover:text-[#ff5f4d]">Privacidad</a><a href="#" class="hover:text-[#ff5f4d]">Cookies</a></div></div></div></footer></body></html>
