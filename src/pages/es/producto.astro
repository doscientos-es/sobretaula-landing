---
import Base from '../../layouts/Base.astro'; import ProductFrame from '../../components/ProductFrame.astro'; import { modules } from '../../data/content';
---
<Base title="Producto — software de gestión para restaurantes | Sobretaula" description="Descubre cómo Sobretaula conecta reservas, TPV, carta, operaciones y finanzas para restaurantes."><section class="mx-auto max-w-7xl px-5 pb-20 pt-20 lg:px-8 lg:pt-28"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#718300]">El producto</p><h1 class="serif mt-5 max-w-4xl text-6xl leading-[.94] text-[#183d31] sm:text-8xl">Todo lo que pasa<br /><em class="text-[#7c9700]">en un mismo lugar.</em></h1><p class="mt-8 max-w-2xl text-lg leading-8 text-[#65736d]">Sobretaula es el software de gestión para restaurantes que convierte la operativa diaria en una visión compartida: desde la reserva hasta la revisión del negocio.</p><div class="mt-14"><ProductFrame label="Vista general del producto · placeholder" /></div></section><section class="bg-[#183d31] px-5 py-20 text-white lg:px-8"><div class="mx-auto max-w-7xl"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#d7f36b]">Un sistema conectado</p><h2 class="serif mt-4 max-w-2xl text-5xl leading-tight">La información correcta, cuando hace falta.</h2><div class="mt-12 grid gap-4 md:grid-cols-3"><div class="rounded-2xl border border-white/15 p-6"><span class="text-3xl text-[#d7f36b]">01</span><h3 class="mt-10 text-xl font-semibold">Organiza</h3><p class="mt-3 leading-7 text-[#b8c9bd]">Prepara el servicio con reservas, plano, carta y equipo.</p></div><div class="rounded-2xl border border-white/15 p-6"><span class="text-3xl text-[#d7f36b]">02</span><h3 class="mt-10 text-xl font-semibold">Atiende</h3><p class="mt-3 leading-7 text-[#b8c9bd]">Da seguimiento a mesas, comandas, cobros y estados.</p></div><div class="rounded-2xl border border-white/15 p-6"><span class="text-3xl text-[#d7f36b]">03</span><h3 class="mt-10 text-xl font-semibold">Entiende</h3><p class="mt-3 leading-7 text-[#b8c9bd]">Revisa caja, facturas e informes para decidir mejor.</p></div></div></div></section><section class="mx-auto max-w-7xl px-5 py-24 lg:px-8"><h2 class="serif text-5xl text-[#183d31]">Explora los módulos</h2><div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{modules.map((m)=><a href={`/es/modulos/${m.slug}`} class="focus-ring rounded-2xl border border-[#dfe5df] bg-[#fffdf8] p-6 hover:border-[#9db26b]"><span class="text-xs font-bold text-[#91a44a]">{m.number}</span><h3 class="mt-9 text-xl font-semibold text-[#183d31]">{m.title}</h3><p class="mt-3 text-sm leading-6 text-[#65736d]">{m.summary}</p><span class="mt-6 inline-block text-sm font-semibold text-[#718300]">Ver módulo →</span></a>)}</div></section></Base>
