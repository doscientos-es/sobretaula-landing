---
import Base from '../../layouts/Base.astro';
import ProductFrame from '../../components/ProductFrame.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import { modules } from '../../data/content';
---
<Base title="Producto de gestión para restaurantes | Sobretaula" description="Conoce cómo Sobretaula conecta reservas, TPV, carta, operaciones y finanzas para restaurantes.">
<section class="mx-auto max-w-7xl px-5 pb-20 pt-20 lg:px-8 lg:pt-28"><div class="grid gap-14 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><h1 class="serif max-w-2xl text-5xl leading-tight text-[#292d34] sm:text-7xl">Una base común para llevar mejor el restaurante</h1><p class="mt-7 max-w-xl text-lg leading-8 text-[#737983]">Sobretaula reúne el trabajo que sucede antes, durante y después del servicio en una plataforma clara para propietarios, gerentes y equipos de sala.</p><a href="/es/contacto" class="focus-ring mt-8 inline-block rounded-lg bg-[#ff5f4d] px-6 py-3.5 font-semibold text-white">Verlo con tu equipo <span aria-hidden="true">↗</span></a></div><ProductFrame label="Vista general del producto · placeholder" /></div></section>
<section class="border-y border-[#e8e8e9] bg-white px-5 py-20 lg:px-8"><div class="mx-auto max-w-7xl"><div class="max-w-2xl"><h2 class="serif text-4xl text-[#292d34]">Cada parte del servicio tiene su lugar</h2><p class="mt-5 leading-7 text-[#737983]">La plataforma mantiene conectados los datos que el equipo consulta y los resultados que el responsable necesita revisar.</p></div><div class="mt-12 grid gap-4 md:grid-cols-3"><article class="rounded-2xl border border-[#e8e8e9] bg-[#fff8f7] p-7"><LucideIcon name="calendar" /><h3 class="mt-8 text-xl font-semibold">Antes del servicio</h3><p class="mt-3 leading-7 text-[#737983]">Prepara reservas, disponibilidad, zonas, carta y equipo con una visión compartida.</p></article><article class="rounded-2xl border border-[#e8e8e9] bg-[#fff8f7] p-7"><LucideIcon name="layout" /><h3 class="mt-8 text-xl font-semibold">Durante el servicio</h3><p class="mt-3 leading-7 text-[#737983]">Consulta el estado de las mesas, coordina comandas y mantén el ritmo sin cambiar de contexto.</p></article><article class="rounded-2xl border border-[#e8e8e9] bg-[#fff8f7] p-7"><LucideIcon name="chart" /><h3 class="mt-8 text-xl font-semibold">Después del servicio</h3><p class="mt-3 leading-7 text-[#737983]">Revisa caja, facturas e informes para entender lo ocurrido y preparar la siguiente decisión.</p></article></div></div></section>
<section class="mx-auto max-w-7xl px-5 py-24 lg:px-8"><div class="max-w-2xl"><h2 class="serif text-5xl text-[#292d34]">Módulos que trabajan juntos</h2><p class="mt-5 text-lg leading-8 text-[#737983]">Empieza por lo que más necesitas hoy y amplía la base cuando tu operación lo pida</p></div><div class="mt-12 grid gap-5 md:grid-cols-2">{modules.map((m)=><a href={`/es/modulos/${m.slug}`} class="focus-ring group rounded-2xl border border-[#e8e8e9] bg-white p-7 transition hover:-translate-y-1 hover:border-[#ffaaa1] hover:shadow-[0_12px_30px_rgb(255_95_77_/_10%)]"><div class="flex items-start justify-between"><span class="grid h-11 w-11 place-items-center rounded-xl bg-[#fff0ee] text-sm font-bold text-[#ff5f4d]">{m.number}</span><span class="text-[#ff5f4d] transition group-hover:translate-x-1" aria-hidden="true">→</span></div><h3 class="mt-8 text-2xl font-semibold text-[#292d34]">{m.title}</h3><p class="mt-3 max-w-lg leading-7 text-[#737983]">{m.summary}</p><ul class="mt-6 space-y-2 text-sm text-[#292d34]">{m.points.map((point)=><li class="flex gap-2"><span class="text-[#ff5f4d]">✓</span>{point}</li>)}</ul></a>)}</div></section>
<section class="bg-[#292d34] px-5 py-24 text-white lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><h2 class="serif text-5xl">Una plataforma pensada para el trabajo real</h2><p class="mt-6 leading-7 text-white/70">Menos información repartida, menos pasos innecesarios y más contexto para decidir.</p></div><ProductFrame label="Flujo del producto · placeholder" /></div></section>
</Base>
