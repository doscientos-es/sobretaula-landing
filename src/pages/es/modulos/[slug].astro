---
import Base from '../../../layouts/Base.astro'; import ProductFrame from '../../../components/ProductFrame.astro'; import { modules } from '../../../data/content';
export function getStaticPaths(){ return modules.map((m)=>({params:{slug:m.slug},props:{module:m}})); }
const { module:m } = Astro.props;
---
<Base title={`${m.title} | Sobretaula`} description={`${m.summary} Descubre cómo encaja ${m.eyebrow} en la gestión de tu restaurante.`}><section class="mx-auto max-w-7xl px-5 pb-20 pt-16 lg:px-8 lg:pt-24"><a href="/es/producto" class="focus-ring text-sm text-[#65736d]">← Producto</a><div class="mt-12 grid gap-14 lg:grid-cols-2 lg:items-center"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[#718300]">{m.eyebrow}</p><h1 class="serif mt-5 text-6xl leading-[.94] text-[#183d31] sm:text-7xl">{m.title}</h1><p class="mt-7 text-lg leading-8 text-[#65736d]">{m.summary}</p><a href="/es/contacto" class="focus-ring mt-8 inline-block rounded-full bg-[#183d31] px-6 py-3.5 font-semibold text-white">Solicitar una demo ↗</a></div><ProductFrame label={`${m.eyebrow} · captura pendiente`} /></div></section><section class="border-y border-[#dfe5df] bg-[#fffdf8] px-5 py-20 lg:px-8"><div class="mx-auto max-w-7xl grid gap-12 lg:grid-cols-2"><div><p class="text-sm font-semibold text-[#7c9700]">Qué resuelve</p><h2 class="serif mt-3 text-5xl text-[#183d31]">Menos fricción en el servicio.</h2></div><div class="space-y-4">{m.points.map((point,index)=><div class="flex gap-4 border-b border-[#dfe5df] pb-4"><span class="text-sm font-bold text-[#91a44a]">0{index+1}</span><p class="font-medium text-[#183d31]">{point}</p></div>)}</div></div></section><section class="mx-auto max-w-7xl px-5 py-24 lg:px-8"><h2 class="serif max-w-2xl text-5xl text-[#183d31]">Un recorrido pensado para el ritmo real.</h2><div class="mt-12 grid gap-4 md:grid-cols-3"><div class="rounded-2xl bg-[#e8eee4] p-6"><span class="text-sm font-bold text-[#718300]">01 · Preparar</span><p class="mt-16 leading-7 text-[#52645a]">Configura la información que tu equipo necesita antes del servicio.</p></div><div class="rounded-2xl bg-[#e0eadb] p-6"><span class="text-sm font-bold text-[#718300]">02 · Operar</span><p class="mt-16 leading-7 text-[#52645a]">Consulta estados y actualiza el trabajo desde una vista clara.</p></div><div class="rounded-2xl bg-[#d7e5d2] p-6"><span class="text-sm font-bold text-[#718300]">03 · Revisar</span><p class="mt-16 leading-7 text-[#52645a]">Cierra el ciclo con información útil para la siguiente decisión.</p></div></div><div class="mt-16 rounded-3xl bg-[#d7f36b] p-8 sm:p-12"><h2 class="serif text-4xl text-[#183d31]">¿Quieres verlo con tu operativa?</h2><a href="/es/contacto" class="focus-ring mt-7 inline-block rounded-full bg-[#183d31] px-6 py-3.5 font-semibold text-white">Hablar con el equipo ↗</a></div></section></Base>
