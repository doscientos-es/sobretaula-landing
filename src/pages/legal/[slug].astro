---
import Base from '../../layouts/Base.astro'; import { SITE, LEGAL_DOCUMENTS } from '../../constants';
const legalDocuments = {
  'aviso-legal': ['Aviso legal', [['Titularidad', `Este sitio web pertenece a ${SITE.legalName}, con NIF ${SITE.nif} y domicilio en ${SITE.address}. Contacto: ${SITE.email}.`], ['Objeto', 'Sobretaula presenta un software de gestión para restaurantes. Sus contenidos son informativos y no constituyen una oferta contractual salvo indicación expresa.'], ['Propiedad intelectual', 'Los textos, identidad visual, código, imágenes y elementos de este sitio están protegidos. No se permite su reutilización sin autorización.']]],
  privacidad: ['Política de privacidad', [['Responsable', `${SITE.legalName} (${SITE.nif}), ${SITE.address}. Email: ${SITE.email}.`], ['Datos y finalidad', 'Si solicitas una demo podemos recibir tu nombre, restaurante, localidad, email, teléfono y el contenido que decidas enviarnos. Los usamos para responder y preparar una conversación comercial. No vendemos tus datos.'], ['Conservación y derechos', `Conservamos la información el tiempo necesario. Puedes solicitar acceso, rectificación, supresión, oposición, limitación o portabilidad escribiendo a ${SITE.email}.`]]],
  cookies: ['Política de cookies', [['Situación actual', 'Esta landing estática no utiliza cookies publicitarias ni perfiles de seguimiento por defecto. El formulario abre tu aplicación de correo y no almacena los datos en esta web.'], ['Cookies técnicas', 'El alojamiento puede procesar datos técnicos imprescindibles para servir y proteger la página.'], ['Cambios', `Si incorporamos analítica o cookies no esenciales, actualizaremos esta política y ofreceremos los controles necesarios. Consultas: ${SITE.email}.`]]],
  'condiciones-saas': ['Condiciones del servicio SaaS', [['Objeto', 'Sobretaula ofrece herramientas digitales para organizar reservas, sala, carta, equipo, caja, facturas e informes según el plan contratado.'], ['Cuenta y uso', 'La empresa cliente debe facilitar información correcta, proteger sus credenciales y dar acceso solo a personas autorizadas.'], ['Planes y datos', 'El plan, precio, impuestos y servicios se concretan en la propuesta aceptada. La empresa cliente conserva el control de sus datos; el acuerdo de tratamiento deberá formalizarse cuando corresponda.'], ['Disponibilidad y revisión', 'Las integraciones, hardware y obligaciones fiscales específicas solo se incluyen si aparecen expresamente en el pedido. Este documento es una base informativa y requiere revisión jurídica antes de contratar.']]],
};
export function getStaticPaths(){ return LEGAL_DOCUMENTS.map(({slug,title,sections})=>({params:{slug},props:{title,sections}})); }
const { title, sections } = Astro.props;
---
<Base title={`${title} | Sobretaula`} description={`${title} de Sobretaula.`}><section class="mx-auto max-w-3xl px-5 py-20 lg:px-8 lg:py-28"><a class="focus-ring text-sm text-[#737983]" href="/es">← Volver a Sobretaula</a><p class="mt-14 text-sm font-semibold text-[#c34337]">Información legal</p><h1 class="serif mt-4 text-6xl leading-none text-[#292d34]">{title}</h1><div class="mt-14 space-y-10">{sections.map(([heading, text])=><section><h2 class="text-xl font-semibold text-[#292d34]">{heading}</h2><p class="mt-3 leading-7 text-[#737983]">{text}</p></section>)}</div><p class="mt-16 border-t border-[#e8e8e9] pt-6 text-sm text-[#737983]">Última actualización: {SITE.lastUpdated}</p></section></Base>
