---
import Base from '../layouts/Base.astro';
import ProductFrame from '../components/ProductFrame.astro';
import { modules } from '../data/content';
---
<Base lang="ca" title="Sobretaula — gestió clara per al teu restaurant" description="Reserves, sala, carta, equip i finances connectats per treballar amb més claredat.">
<section class="mx-auto max-w-7xl px-5 pb-20 pt-20 lg:px-8 lg:pb-28 lg:pt-28"><div class="grid items-end gap-14 lg:grid-cols-[.9fr_1.1fr]"><div><h1 class="serif text-6xl leading-[.94] text-[#183d31] sm:text-8xl">El restaurant<br /><em class="text-[#ff5f4d]">sota control.</em></h1><p class="mt-8 max-w-xl text-lg leading-8 text-[#65736d]">Reserves, sala, carta, equip i finances connectats en un mateix lloc. Sobretaula ajuda el teu equip a treballar amb claredat quan el servei apreta.</p><div class="mt-9 flex flex-wrap gap-3"><a href="/ca/contacte" class="focus-ring rounded-lg bg-[#183d31] px-6 py-3.5 font-semibold text-white">Demanar una demo <span aria-hidden="true">↗</span></a><a href="#producte" class="focus-ring rounded-lg border border-[#b9c8ba] px-6 py-3.5 font-semibold text-[#183d31]">Veure el producte</a></div></div><div><ProductFrame label="Resum del restaurant · imatge AVIF pendent" /><p class="mt-4 text-center text-xs text-[#829087]">La captura real del producte ocuparà aquest espai.</p></div></div></section>
<section id="moduls" class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><h2 class="serif text-5xl text-[#183d31]">Tot el que necessita el teu dia</h2><p class="mt-5 max-w-2xl text-lg leading-8 text-[#65736d]">Una visió compartida per preparar el servei, coordinar l'equip i revisar el negoci.</p><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{modules.map((m)=><a href={`/es/modulos/${m.slug}`} class="focus-ring rounded-2xl border border-[#dfe5df] bg-white p-6"><span class="text-xs font-bold text-[#ff5f4d]">{m.number}</span><h3 class="mt-9 text-xl font-semibold text-[#183d31]">{m.title}</h3><p class="mt-3 text-sm leading-6 text-[#65736d]">{m.summary}</p></a>)}</div></section>
<section id="contacte" class="mx-auto max-w-7xl px-5 pb-24 lg:px-8"><div class="rounded-2xl bg-[#fff0ee] p-8 sm:p-14"><h2 class="serif text-5xl leading-none text-[#183d31] sm:text-6xl">El teu restaurant,<br />més clar cada dia.</h2><p class="mt-6 max-w-lg leading-7 text-[#52645a]">Parlem de la teva operativa i t'ensenyem com pot encaixar Sobretaula.</p><a href="/ca/contacte" class="focus-ring mt-8 inline-block rounded-lg bg-[#183d31] px-6 py-3.5 font-semibold text-white">Parlar amb l'equip ↗</a></div></section>
</Base>
