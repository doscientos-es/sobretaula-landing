---
import Base from '../layouts/Base.astro';
import ProductFrame from '../components/ProductFrame.astro';
import { modules, faqs } from '../data/content';
---
<Base title="Sobretaula — gestión clara para tu restaurante" description="Reservas, sala, carta, equipo y finanzas conectados para trabajar con más claridad.">
<section class="mx-auto max-w-5xl px-5 pb-20 pt-24 text-center lg:px-8 lg:pb-28 lg:pt-32"><h1 class="serif mx-auto max-w-3xl text-5xl leading-[.98] text-[#292d34] sm:text-7xl">Todo el restaurante<br /><span class="text-[#ff5f4d]">en una misma vista.</span></h1><p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-[#737983]">Sobretaula conecta reservas, sala, carta, equipo y finanzas para que tu equipo trabaje con claridad cuando el servicio aprieta.</p><div class="mt-8 flex justify-center gap-3"><a href="/es/contacto" class="focus-ring rounded-lg bg-[#ff5f4d] px-6 py-3.5 font-semibold text-white shadow-sm">Solicitar una demo <span aria-hidden="true">↗</span></a><a href="#producto" class="focus-ring rounded-lg border border-[#d8d9dc] bg-white px-6 py-3.5 font-semibold text-[#292d34]">Ver el producto</a></div><div class="mx-auto mt-16 max-w-5xl"><ProductFrame label="Vista general del producto · imagen AVIF pendiente" /><p class="mt-4 text-xs text-[#737983]">Placeholder de captura del software. Aquí irá la imagen o el vídeo real del producto.</p></div></section>
<section class="border-y border-[#e8e8e9] bg-white px-5 py-16 lg:px-8"><div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-3"><div><h2 class="serif text-4xl leading-tight text-[#292d34]">La información que necesitas, cuando la necesitas.</h2></div><div class="md:col-span-2 grid gap-4 sm:grid-cols-3"><div class="rounded-xl border border-[#e8e8e9] p-5"><span class="text-2xl text-[#ff5f4d]">⌂</span><h3 class="mt-7 font-semibold">Antes del servicio</h3><p class="mt-2 text-sm leading-6 text-[#737983]">Reservas, mesas, carta y equipo preparados.</p></div><div class="rounded-xl border border-[#e8e8e9] p-5"><span class="text-2xl text-[#ff5f4d]">◫</span><h3 class="mt-7 font-semibold">Durante el servicio</h3><p class="mt-2 text-sm leading-6 text-[#737983]">Una visión compartida de lo que está pasando.</p></div><div class="rounded-xl border border-[#e8e8e9] p-5"><span class="text-2xl text-[#ff5f4d]">↗</span><h3 class="mt-7 font-semibold">Después del servicio</h3><p class="mt-2 text-sm leading-6 text-[#737983]">Caja, facturas e informes para decidir.</p></div></div></div></section>
<section id="producto" class="mx-auto max-w-7xl px-5 py-24 lg:px-8"><div class="max-w-2xl"><h2 class="serif text-5xl leading-tight text-[#292d34]">Del primer cliente del día al último cierre.</h2><p class="mt-5 leading-7 text-[#737983]">Cada módulo responde a una parte del trabajo. Juntos forman una base común para operar mejor y tener una lectura completa del negocio.</p></div><div id="modulos" class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{modules.map((m)=><a href={`/es/modulos/${m.slug}`} class="focus-ring rounded-xl border border-[#e8e8e9] bg-white p-6 hover:border-[#ffaaa1]"><span class="text-xs font-bold text-[#ff5f4d]">{m.number}</span><h3 class="mt-9 text-xl font-semibold text-[#292d34]">{m.title}</h3><p class="mt-3 text-sm leading-6 text-[#737983]">{m.summary}</p><span class="mt-6 inline-block text-sm font-semibold text-[#ff5f4d]">Explorar módulo →</span></a>)}</div></section>
<section class="bg-[#292d34] px-5 py-24 text-white lg:px-8"><div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-2 lg:items-center"><div><h2 class="serif text-5xl leading-tight">Un hilo conductor para cada servicio.</h2><p class="mt-6 max-w-lg leading-7 text-white/70">Preparar, atender, cerrar y revisar. Sobretaula acompaña el ritmo del restaurante y mantiene al equipo alineado.</p></div><div class="space-y-3"><div class="flex items-center gap-4 rounded-xl border border-[#ff5f4d]/30 bg-[#ff5f4d]/10 p-4"><span class="grid h-10 w-10 place-items-center rounded-lg bg-[#ff5f4d] font-semibold">01</span><div><h3 class="font-semibold">Preparar</h3><p class="text-sm text-white/70">Consulta reservas, zonas y equipo.</p></div></div><div class="flex items-center gap-4 rounded-xl border border-[#ff5f4d]/30 bg-[#ff5f4d]/10 p-4"><span class="grid h-10 w-10 place-items-center rounded-lg bg-[#ff5f4d] font-semibold">02</span><div><h3 class="font-semibold">Atender</h3><p class="text-sm text-white/70">Coordina mesas, comandas y cobros.</p></div></div><div class="flex items-center gap-4 rounded-xl border border-[#ff5f4d]/30 bg-[#ff5f4d]/10 p-4"><span class="grid h-10 w-10 place-items-center rounded-lg bg-[#ff5f4d] font-semibold">03</span><div><h3 class="font-semibold">Entender</h3><p class="text-sm text-white/70">Revisa cómo ha ido el servicio.</p></div></div></div></div></section>
<section class="mx-auto max-w-7xl px-5 py-24 lg:px-8"><div class="grid gap-14 lg:grid-cols-[.8fr_1.2fr]"><div><h2 class="serif text-5xl leading-tight text-[#292d34]">Lo importante, claro desde el principio.</h2></div><div class="divide-y divide-[#e8e8e9]">{faqs.map(([question,answer])=><details class="group py-5"><summary class="focus-ring cursor-pointer list-none pr-8 font-semibold">{question}<span class="float-right text-[#ff5f4d] transition group-open:rotate-45">+</span></summary><p class="mt-3 max-w-2xl leading-7 text-[#737983]">{answer}</p></details>)}</div></div></section>
<section id="contacto" class="mx-auto max-w-7xl px-5 pb-24 lg:px-8"><div class="rounded-2xl bg-[#fff0ee] p-8 sm:p-14"><h2 class="serif text-5xl leading-none text-[#292d34] sm:text-6xl">Tu restaurante,<br />más claro cada día.</h2><p class="mt-6 max-w-lg leading-7 text-[#737983]">Cuéntanos cómo trabajáis hoy y te enseñamos cómo puede encajar Sobretaula.</p><a href="/es/contacto" class="focus-ring mt-8 inline-block rounded-lg bg-[#ff5f4d] px-6 py-3.5 font-semibold text-white">Hablar con el equipo ↗</a></div></section>
</Base>
